  (text "All three sensors share SPI (PS=GND on BMI088 selects SPI). LIS3MDL: 16-bit, +-4 gauss, ~3 mG rms @80 Hz -> ~40 nT after averaging: adequate for low-altitude anomaly matching." (exclude_from_sim no) (at 30 160 0) (effects (font (size 2.0 2.0)) (justify left bottom)) (uuid "287587d8-2b6f-401e-a8e6-de99b1d30a0f"))
